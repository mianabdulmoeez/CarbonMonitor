*.nupkg
*.snupkg
.nuget/
**/packages/

# ----- Publish & Installer Output -----
publish/
output/

# ----- Visual Studio -----
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.rsuser

# ----- Visual Studio Code -----
.vscode/
*.code-workspace

# ----- JetBrains Rider -----
.idea/
*.sln.iml

# ----- Project-specific User Files -----
*.csproj.user
*.unityproj
*.booproj
*.svd
*.pdb
*.mdb

# ----- Build Results -----
[Dd]ebugPublic/
[Rr]eleases/
